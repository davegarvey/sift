# Enable the MCP server for AI agent integration.
# Copy this file to .env and uncomment the line below:
# MCP_ENABLED=true

# Enable sync and create local SQLite databases in this directory for Node, Bun, and Vite dev.
# In Docker, the image uses /data and declares it as a persistent volume.
# SIFT_DATA_DIR=./data

# Enable server-side polling when SIFT_DATA_DIR is set.
# FEED_POLLING=true

# Number of reverse proxies in front of this server whose X-Forwarded-For entry
# identifies the client for proxy rate limits. Leave unset to use the socket
# address and ignore X-Forwarded-For.
# TRUST_PROXY_HOPS=1
