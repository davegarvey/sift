{
  "dependencies": {
    "@extractus/feed-extractor": "^7.2.1",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.13.5",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "lucide-solid": "^1.22.0",
    "qrcode-generator": "^1.5.2",
    "solid-js": "^1.9.13"
  },
  "description": "Sift — a simple, slick, browser-first RSS reader.",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "eslint": "^9.0.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "miniflare": "^5.20260911.0-alpha",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "license": "MIT",
  "name": "sift",
  "optionalDependencies": {
    "fake-indexeddb": "^6.2.5"
  },
  "overrides": {
    "fast-xml-parser": "5.11.1",
    "miniflare": "$miniflare",
    "wrangler": "$wrangler"
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "deploy": "git pull --ff-only && vite build && wrangler d1 migrations apply sift-sync --remote && wrangler deploy",
    "deploy:ci": "wrangler d1 migrations apply sift-sync --remote && wrangler deploy",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "start": "tsx server/node.ts",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.64.2",
  "workspaces": [
    "packages/siftctl"
  ]
}
